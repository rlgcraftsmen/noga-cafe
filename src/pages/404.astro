---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBusiness } from "@/lib/business";

const business = await getBusiness();
const { notFound } = business.content;
---

<BaseLayout title={`${notFound.title} — ${business.data.name}`} noindex>
  <main id="main">
    <h1>{notFound.title}</h1>
    <p>{notFound.body}</p>
    <p><a href="/">{notFound.backLabel}</a></p>
  </main>
</BaseLayout>
